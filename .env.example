APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://relations:URL_ENCODED_PASSWORD@127.0.0.1:5432/relations?sslmode=disable
# Compose publishes the frontend only. Keep PUBLIC_URL/CORS_ORIGINS aligned with WEB_PORT.
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=5173
# Generate a URL-safe password; Compose interpolates it into DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
# Empty for direct local development. Compose trusts only the frontend proxy IP.
TRUSTED_PROXIES=
# Base64 encoded random 32 bytes. Keep outside database and source control.
AI_ENCRYPTION_KEY=
AI_TIMEOUT=60s
AI_RETRIES=1
AI_MAX_TOKENS=4096
GLOBAL_DAILY_LIMIT=1000
USER_DAILY_LIMIT=10
MIN_AGE=18
LOG_LEVEL=info
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Empty means enabled in development/test, disabled in production.
# Default accounts are added only when their role has no account; never reset.
SEED_DEFAULT_ACCOUNTS=
# Override local bootstrap accounts or use with the explicit seed-admin command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_EMAIL=
USER_PASSWORD=
